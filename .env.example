# ============================================================
# FitWell Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Never commit your .env file — it's already in .gitignore.
# ============================================================

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Location / Facility Search Strategy
# Set to "true" to use built-in dummy gym/park data (no API key required).
# Set to "false" only if you wire up a real places API in graph/tools.py.
USE_DUMMY_MAP_DATA=true
