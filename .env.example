# ============================================================
# FitWell Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Never commit your .env file — it's already in .gitignore.
# ============================================================

# LLM Provider: "ollama" (local, no API key needed) or "gemini" (cloud)
LLM_PROVIDER=ollama

# Ollama Settings (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini Settings (used when LLM_PROVIDER=gemini)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Location / Facility Search Strategy
# Set to "true" to use built-in dummy gym/park data (no API key required).
# Set to "false" only if you wire up a real places API in graph/tools.py.
USE_DUMMY_MAP_DATA=true
